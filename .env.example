# Salin file ini menjadi .env lalu isi nilainya. Jangan commit .env.

# true di server (PWS), false/kosong di lokal
PRODUCTION=false

# Wajib saat PRODUCTION=true. Buat dengan:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# Opsional. Default: true di lokal, false di production
DEBUG=

# Hanya dipakai saat PRODUCTION=true
DB_NAME=
DB_HOST=
DB_PORT=
DB_USER=
DB_PASSWORD=
SCHEMA=

# Opsional, hanya dipakai saat PRODUCTION=true
SECURE_SSL_REDIRECT=true
SECURE_HSTS_SECONDS=3600
